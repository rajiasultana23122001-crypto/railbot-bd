# Copy this file to .env (which is gitignored) and fill in real values.
# Never commit .env itself.
#
# Twilio credentials - used only for passenger OTP verification now
# (core/services/twilio_verify.py). The Manager Agent's delay notices went
# out as Twilio voice calls in an earlier phase; that has been replaced by
# SMS through sms.net.bd (below), so no Twilio phone number is needed here
# any more.
#
# Without these three set, OTP verification falls back to a simulated mode:
# the code "000000" is accepted instead of a real one texted out. That's
# normal for local dev - fill these in only when testing against real Twilio.
#
# One-time setup before OTP verification can go live:
#   Console -> Verify -> Services -> Create new Service (or
#   client.verify.v2.services.create(friendly_name="RailBot BD") via API).
#   Copy the resulting SID (starts with "VA") -> TWILIO_VERIFY_SERVICE_SID.
#
# Trial-account note: Verify SMS can only reach numbers you have verified in
# the Console first.

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# sms.net.bd - used by the Manager Agent (core/agents/manager_agent.py) to
# text passengers about delays. Without this set, sends are simulated: the
# agent log records what would have been sent instead of calling the API.
# Get a key from https://sms.net.bd's dashboard.
SMS_NET_BD_API_KEY=
