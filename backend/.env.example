# Copy this file to .env (which is gitignored) and fill in real values.
# Never commit .env itself.
#
# sms.net.bd - used for two things now: the Manager Agent
# (core/agents/manager_agent.py) texting passengers about delays, and
# passenger OTP verification (core/services/otp.py) at signup. One key
# covers both, since both go through the same send_sms() call.
#
# Without this set, sends are simulated: delay texts are only logged, and
# OTP verification accepts the fixed code "000000" instead of a real one
# being texted out. That's normal for local dev - fill this in only when
# testing against real sms.net.bd sends.
#
# Get a key from https://sms.net.bd's dashboard.
SMS_NET_BD_API_KEY=

# Google Gemini - used by the Advisor Agent (core/services/gemini.py) to write
# its shift briefing, and by nothing else. The model phrases figures the other
# four agents already produced; it makes no decisions, and none of its output
# is written back to a train, a platform or a booking.
#
# Without this set, the briefing is written from a template using the same
# figures. Nothing else changes - the recommendations in the agent log come
# from rules either way. Failures fall back to the template too, so a slow API
# cannot hold up an agent cycle.
#
# Free key: https://aistudio.google.com/apikey (AI Studio, free tier).
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.0-flash; set this only to pin a different
# model, since model names move faster than this project will.
GEMINI_MODEL=
